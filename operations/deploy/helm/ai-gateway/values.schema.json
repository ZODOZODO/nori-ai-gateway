{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "profile": {
      "type": "string",
      "enum": [
        "verify",
        "prod"
      ]
    },
    "replicaCount": {
      "type": "integer",
      "const": 1
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "const": "harbor.nori.local/nori-tc/ai-gateway"
        },
        "digest": {
          "type": "string",
          "pattern": "^([0-9a-f]{64})?$"
        }
      },
      "required": [
        "repository",
        "digest"
      ]
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxRunningJobs": {
          "type": "integer",
          "const": 1
        },
        "generationConcurrency": {
          "type": "integer",
          "const": 1
        },
        "queuedDepth": {
          "type": "integer",
          "const": 4
        },
        "queueWaitLimit": {
          "const": "60s"
        },
        "jobLifetimeLimit": {
          "const": "180s"
        }
      },
      "required": [
        "maxRunningJobs",
        "generationConcurrency",
        "queuedDepth",
        "queueWaitLimit",
        "jobLifetimeLimit"
      ]
    },
    "restoreMode": {
      "type": "boolean"
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backupPointAt": {
          "type": "string",
          "pattern": "^(|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z)$"
        }
      },
      "required": [
        "backupPointAt"
      ]
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "baseUrl": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      },
      "required": [
        "enabled",
        "baseUrl",
        "port"
      ]
    },
    "knowledgeSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "read": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "enabled"
          ]
        }
      },
      "required": [
        "read"
      ]
    },
    "ingest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "fixtureCatalog": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "enabled"
          ]
        }
      },
      "required": [
        "enabled",
        "fixtureCatalog"
      ]
    },
    "fixtureCatalog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content": {
          "type": "string"
        },
        "prefix": {
          "type": "string"
        }
      },
      "required": [
        "content",
        "prefix"
      ]
    },
    "seaweed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "s3Endpoint": {
          "type": "string",
          "pattern": "^(|https?://[^\\s]+)$"
        }
      },
      "required": [
        "s3Endpoint"
      ]
    },
    "kafka": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bootstrapServers": {
          "type": "string"
        },
        "topic": {
          "type": "string"
        },
        "groupId": {
          "type": "string"
        }
      },
      "required": [
        "bootstrapServers",
        "topic",
        "groupId"
      ]
    },
    "sanitize": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verifyRuleSet": {
          "type": "string",
          "enum": [
            "mask-v1",
            "mask-v1r"
          ]
        }
      },
      "required": [
        "verifyRuleSet"
      ]
    },
    "testHooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "clock": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "",
                "FROZEN",
                "SYSTEM"
              ]
            },
            "initial": {
              "type": "string",
              "pattern": "^(|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z)$"
            }
          },
          "required": [
            "mode",
            "initial"
          ]
        }
      },
      "required": [
        "enabled",
        "clock"
      ]
    },
    "credentialsRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "acceptanceSigner": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$"
        },
        "acceptanceClient": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$"
        },
        "acceptanceFixtureWriter": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$"
        }
      },
      "required": [
        "acceptanceSigner",
        "acceptanceClient",
        "acceptanceFixtureWriter"
      ]
    },
    "configSecret": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "const": false
        },
        "name": {
          "const": "ai-gateway-config"
        }
      },
      "required": [
        "create",
        "name"
      ]
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "type": {
          "type": "string"
        },
        "schedule": {
          "type": "string"
        },
        "destination": {
          "type": "string"
        },
        "ageRecipient": {
          "type": "string"
        },
        "retentionDays": {
          "type": [
            "integer",
            "string"
          ]
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "digest": {
              "type": "string"
            }
          },
          "required": [
            "digest"
          ]
        }
      },
      "required": [
        "enabled"
      ]
    },
    "netpol": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dns": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "approvalRef": {
                  "type": "string",
                  "minLength": 1
                },
                "port": {
                  "const": 53
                },
                "namespace": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                },
                "podSelector": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "approvalRef",
                "port",
                "namespace",
                "podSelector"
              ]
            },
            "loki": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "approvalRef": {
                  "type": "string",
                  "minLength": 1
                },
                "port": {
                  "const": 3100
                },
                "namespace": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                },
                "podSelector": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "approvalRef",
                "port",
                "namespace",
                "podSelector"
              ]
            },
            "tempo": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "approvalRef": {
                  "type": "string",
                  "minLength": 1
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "namespace": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                },
                "podSelector": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "approvalRef",
                "port",
                "namespace",
                "podSelector"
              ]
            },
            "alloy": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "approvalRef": {
                  "type": "string",
                  "minLength": 1
                },
                "port": {
                  "const": 4318
                },
                "namespace": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                },
                "podSelector": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "approvalRef",
                "port",
                "namespace",
                "podSelector"
              ]
            },
            "gitlab": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "approvalRef": {
                  "type": "string",
                  "minLength": 1
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "cidr": {
                  "type": "string",
                  "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/32$"
                },
                "namespace": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                },
                "podSelector": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "approvalRef",
                "port"
              ],
              "oneOf": [
                {
                  "required": [
                    "cidr"
                  ],
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "namespace"
                        ]
                      },
                      {
                        "required": [
                          "podSelector"
                        ]
                      }
                    ]
                  }
                },
                {
                  "required": [
                    "namespace",
                    "podSelector"
                  ],
                  "not": {
                    "required": [
                      "cidr"
                    ]
                  }
                }
              ]
            },
            "inference": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "approvalRef": {
                  "type": "string",
                  "minLength": 1
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "cidr": {
                  "type": "string",
                  "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/32$"
                }
              },
              "required": [
                "approvalRef",
                "port",
                "cidr"
              ]
            },
            "seaweed": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "approvalRef": {
                  "type": "string",
                  "minLength": 1
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "cidr": {
                  "type": "string",
                  "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/32$"
                }
              },
              "required": [
                "approvalRef",
                "port",
                "cidr"
              ]
            },
            "kafka": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "approvalRef": {
                  "type": "string",
                  "minLength": 1
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "namespace": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                },
                "podSelector": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "approvalRef",
                "port",
                "namespace",
                "podSelector"
              ]
            },
            "metrics": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "approvalRef": {
                  "type": "string",
                  "minLength": 1
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "namespace": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                },
                "podSelector": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "approvalRef",
                "port",
                "namespace",
                "podSelector"
              ]
            }
          },
          "required": []
        }
      },
      "required": [
        "targets"
      ]
    },
    "egressProbe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "host": {
                "type": "string",
                "minLength": 1
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "approvalRef": {
                "type": "string",
                "minLength": 1
              },
              "expect": {
                "type": "string",
                "enum": [
                  "ALLOWED",
                  "BLOCKED"
                ]
              }
            },
            "required": [
              "id",
              "host",
              "port",
              "expect",
              "approvalRef"
            ]
          }
        }
      },
      "required": [
        "targets"
      ]
    },
    "specVerify": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "v1"
        },
        "gzipBase64": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]*={0,2}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^([0-9a-f]{64})?$"
        },
        "expectedSha256": {
          "type": "string",
          "pattern": "^([0-9a-f]{64})?$"
        }
      },
      "required": [
        "version",
        "gzipBase64",
        "sha256",
        "expectedSha256"
      ]
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "suite": {
          "type": "string",
          "enum": [
            "none",
            "F1",
            "F1-RUBRIC",
            "F2",
            "F2-OUTAGE",
            "F2-RUBRIC",
            "F3-PROBE",
            "F3",
            "F3-ACL",
            "F3-RULEVER",
            "F4",
            "F4-RUBRIC",
            "F4-OUTAGE",
            "F4-CLOCK",
            "F4-PERF",
            "F4-RESTORE-PREP",
            "F4-RESTORE-MUTATE",
            "F4-RESTORE"
          ]
        },
        "parentRunId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]*$"
        },
        "outagePhase": {
          "type": "string",
          "enum": [
            "",
            "STOPPED",
            "LOADING"
          ]
        },
        "prepManifest": {
          "type": "string"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "const": "harbor.nori.local/nori-tc/ai-gateway-acceptance"
            },
            "digest": {
              "type": "string",
              "pattern": "^([0-9a-f]{64})?$"
            }
          },
          "required": [
            "repository",
            "digest"
          ]
        },
        "readback": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "loki": {
              "type": "string"
            },
            "tempo": {
              "type": "string"
            },
            "metrics": {
              "type": "string"
            },
            "approvalRef": {
              "type": "string"
            }
          },
          "required": [
            "loki",
            "tempo",
            "metrics",
            "approvalRef"
          ]
        },
        "buildIdentityJson": {
          "type": "string"
        },
        "rubricTargets": {
          "type": "string"
        }
      },
      "required": [
        "enabled",
        "suite",
        "parentRunId",
        "outagePhase",
        "prepManifest",
        "image",
        "readback"
      ]
    }
  },
  "required": [
    "profile",
    "replicaCount",
    "image",
    "capacity",
    "restoreMode",
    "recovery",
    "inference",
    "knowledgeSource",
    "ingest",
    "fixtureCatalog",
    "seaweed",
    "kafka",
    "testHooks",
    "credentialsRef",
    "configSecret",
    "backup",
    "netpol",
    "egressProbe",
    "specVerify",
    "acceptance"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Gateway 사전작성 차트 입력 계약",
  "allOf": [
    {
      "if": {
        "properties": {
          "acceptance": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "specVerify": {
            "properties": {
              "gzipBase64": {
                "minLength": 1
              },
              "sha256": {
                "pattern": "^[0-9a-f]{64}$"
              },
              "expectedSha256": {
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  ]
}
